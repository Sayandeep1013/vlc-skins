<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>VLC Redesign</AssemblyName>
    <RootNamespace>RedesignPlayer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cone.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <!-- The UI is English; skip WPF's translated resource DLLs (smaller downloads). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>VLC Redesign</Product>
    <AssemblyTitle>VLC Redesign</AssemblyTitle>
    <Description>A media player built on VLC's engine, from Juxtopposed's VLC redesign.</Description>
    <Copyright>Code: MIT. Design: Juxtopposed, CC BY 4.0.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uses the libvlc that ships with the installed VLC (found at runtime), so no
         VideoLAN.LibVLC.Windows package: same engine, same plugins, same version. -->
    <PackageReference Include="LibVLCSharp" Version="3.9.1" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\cone.ico" />
    <Resource Include="Assets\Inter.ttf" />
  </ItemGroup>

</Project>
